# archied — the archie daemon, built as a standalone container.
# Run via docker compose alongside NATS.

FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /usr/local/bin/archied ./cmd/archied/

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin/archied /usr/local/bin/archied
ENTRYPOINT ["archied"]
